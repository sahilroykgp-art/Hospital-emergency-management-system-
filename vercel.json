{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ui", "destination": "/index.html" },
    { "source": "/ui/", "destination": "/index.html" },
    { "source": "/ui/:path*", "destination": "/:path*" }
  ]
}
